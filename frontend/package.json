{
  "name": "sistema-rifas-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host 0.0.0.0",
    "dev:inotify": "vite",
    "dev:poll": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src tests --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:app": "vitest run tests/app",
    "test:shared": "vitest run tests/shared",
    "test:features": "vitest run tests/features",
    "test:secretaria": "vitest run tests/features/secretaria",
    "test:rifas": "vitest run tests/features/rifas",
    "test:tesouraria": "vitest run tests/features/tesouraria",
    "test:auditoria": "vitest run tests/features/auditoria",
    "test:premios": "vitest run tests/features/premios",
    "test:auth": "vitest run tests/features/auth",
    "test:coverage": "vitest run --coverage",
    "test:e2e:tesouraria": "playwright test --config playwright.config.ts tests/e2e/tesouraria/venda-pix-pendente.spec.ts",
    "test:e2e:tesouraria:emulators": "cd ../backend/functions && npm run build && npx firebase emulators:exec --config ../../firebase.json --project rifasaderidos2026 --only auth,firestore,storage,functions \"cd ../../frontend && npm run test:e2e:tesouraria\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.8",
    "@mui/material": "^7.3.8",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "firebase": "^12.9.0",
    "framer-motion": "^12.40.0",
    "papaparse": "^5.5.3",
    "phosphor-react": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.6",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "happy-dom": "^20.6.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "^5.4.10",
    "vitest": "^4.0.18"
  }
}
