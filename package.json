{
  "name": "sistema-rifas",
  "private": true,
  "scripts": {
    "dev:vite": "npm --prefix frontend run dev",
    "dev:vite:network": "npm --prefix frontend run dev:network",
    "dev:backend:local": "npm --prefix backend/functions run dev:emulators",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:frontend:network": "npm --prefix frontend run dev:network",
    "dev:emulators": "npm --prefix backend/functions run dev:emulators",
    "emulators:check": "node backend/scripts/verificarPortasEmuladores.mjs",
    "build:frontend": "npm --prefix frontend run build",
    "build:backend": "npm --prefix backend/functions run build",
    "build": "npm run build:backend && npm run build:frontend",
    "test:frontend": "npm --prefix frontend run test:run",
    "test:backend": "npm --prefix backend/functions test",
    "test": "npm run test:backend && npm run test:frontend",
    "check:docs": "node scripts/check-inline-docs.mjs",
    "setup:linux": "bash scripts/dev/configurar-inotify-linux.sh",
    "ngrok": "npx ngrok http 5001",
    "copiar:producao": "npm --prefix backend/functions run copiar:producao",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": "npm --prefix backend/functions install",
    "install:all": "npm run install:frontend && npm run install:backend",
    "postinstall": "npm run install:all",
    "ci:frontend": "npm --prefix frontend ci",
    "ci:backend": "npm --prefix backend/functions ci",
    "ci:all": "npm run ci:frontend && npm run ci:backend"
  }
}
