rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Bloqueia tudo por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Comprovantes de venda e correção.
    // Usa {filePath=**} para aceitar subpastas futuras sem quebrar o app.
    match /comprovantes/{filePath=**} {
      allow read: if request.auth != null && (
        request.auth.token.cargo in [
          "admin", "presidencia", "diretor_tesouraria",
          "membro_tesouraria", "tesouraria"
        ] ||
        request.auth.token.role in [
          "admin", "presidencia", "diretor_tesouraria",
          "membro_tesouraria", "tesouraria"
        ]
      );

      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if false;
    }

    // Comprovantes anexados depois, usados pelo método anexarComprovante.
    match /comprovantes_atrasados/{filePath=**} {
      allow read: if request.auth != null && (
        request.auth.token.cargo in [
          "admin", "presidencia", "diretor_tesouraria",
          "membro_tesouraria", "tesouraria"
        ] ||
        request.auth.token.role in [
          "admin", "presidencia", "diretor_tesouraria",
          "membro_tesouraria", "tesouraria"
        ]
      );

      allow create, update: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if false;
    }

    // Prêmios da Rifa (leitura pública da vitrine, gestão restrita à comissão)
    match /premios/{filePath=**} {
      allow read: if true;

      allow create, update: if request.auth != null && (
        request.auth.token.cargo in [
          "admin", "presidencia", "diretor_tesouraria",
          "membro_tesouraria", "tesouraria", "secretaria"
        ] ||
        request.auth.token.role in [
          "admin", "presidencia", "diretor_tesouraria",
          "membro_tesouraria", "tesouraria", "secretaria"
        ]
      ) && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && (
        request.auth.token.cargo in ["admin", "presidencia"] ||
        request.auth.token.role in ["admin", "presidencia"]
      );
    }

    match /documentos_secretaria/{filePath=**} {
      // Documentos administrativos passam exclusivamente pela API protegida.
      // O Admin SDK ignora rules; clientes web não acessam o bucket diretamente.
      allow read, write: if false;
    }
  }
}
